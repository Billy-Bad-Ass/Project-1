{
  "name": "pseo-forge",
  "version": "0.1.0",
  "private": true,
  "description": "A programmatic-SEO affiliate site engine that runs entirely on free-tier APIs.",
  "scripts": {
    "data:build": "tsx src/pipeline/build-dataset.ts",
    "data:enrich": "tsx src/pipeline/enrich-firecrawl.ts",
    "data:stats": "tsx src/pipeline/stats.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "data:fixtures": "tsx src/pipeline/make-fixtures.ts",
    "postbuild": "tsx src/pipeline/sitemap.ts",
    "check": "npm run typecheck && npm run test",
    "verify": "tsx src/pipeline/verify.ts",
    "data:sample": "tsx src/pipeline/sample.ts"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "5.7.3"
  }
}
