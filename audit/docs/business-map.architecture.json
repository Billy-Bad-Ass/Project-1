    "views": [
      {
        "id": "finding-people",
        "label": "Finding people to contact",
        "focus": [
          "osm",
          "discover",
          "audit",
          "qualify",
          "ledger"
        ],
        "note": "Runs twice daily unattended. Discovery skips every business already in the shared store, so it never finds the same practice twice."
      },
      {
        "id": "reaching-them",
        "label": "Reaching them",
        "focus": [
          "ledger",
          "draft",
          "operator",
          "prospect"
        ],
        "note": "The only manual step, deliberately. Nothing sends by itself, and drafting refuses to run if it cannot read the opt-out list."
      },
      {
        "id": "getting-paid",
        "label": "Getting paid and delivering",
        "focus": [
          "prospect",
          "site",
          "stripe",
          "worker",
          "fulfil"
        ],
        "note": "Payment triggers fulfilment through the Worker rather than being polled for. The report goes to the same business, now a customer."
      },
      {
        "id": "leaving-you-alone",
        "label": "Opting out",
        "focus": [
          "prospect",
          "worker",
          "ledger"
        ],
        "note": "One click writes an opt-out that is never removed. Opening the link does nothing; only submitting does, as mail clients prefetch URLs."
      }
    ]
  },
