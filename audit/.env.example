# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way — this repository is public.

# --- who the reports and emails come from ---
# These appear on every report you send and in every draft.
AUDIT_SENDER_NAME=Your name
AUDIT_SENDER_BUSINESS=Your business name
AUDIT_SENDER_EMAIL=you@example.com
AUDIT_SENDER_PHONE=
AUDIT_SENDER_WEBSITE=

# The closing line of every report. Keep it short and specific.
AUDIT_SENDER_OFFER=

# Currency the dashboard totals revenue in. ISO 4217 code, e.g. USD, GBP.
# Defaults to USD. This only labels money already received — it does not
# convert anything.
AUDIT_CURRENCY=

# Accent colour used across the reports. Defaults to the BBA Network blue
# (#2B5CE6) from brand/assets — set this only to override it.
AUDIT_ACCENT=

# --- outreach: required before any email can be drafted ---
# US commercial email must identify the sender, give a valid physical postal
# address, and offer a working way to opt out. The drafter REFUSES to run
# without these — it will not invent an address, because a made-up one turns
# an omission into a misrepresentation.
#
# This must be a real place that receives mail: a street address, a registered
# agent, or a PO box / private mailbox obtained for the purpose.
AUDIT_POSTAL_ADDRESS=

# One of these two. A URL is better if you have somewhere to host it.
AUDIT_OPT_OUT_REPLY=Reply "stop" to this email and I will not contact you again.
AUDIT_OPT_OUT_URL=

# Set to true ONLY after installing the signature from `npm run signature`
# into your mail client. Gmail appends that signature to everything you send,
# so without this each email carries the address and opt-out twice.
#
# Off by default on purpose: on by default would strip the footer from the
# drafts of anyone who had not installed the signature yet, and the resulting
# email would be missing what it is required to carry with nothing to show it.
AUDIT_SIGNATURE_IN_CLIENT=

# Locale for customer-facing dates and numbers. Defaults to en-US.
# This is not cosmetic: 08/09/2026 is a different day in en-GB and en-US.
AUDIT_LOCALE=

# --- selling audits (see SELLING.md) ---
# Test key first: sk_test_... Never commit either.
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK=
PRICE_DISPLAY=

# --- shared store (the Cloudflare Worker in worker/) ---
#
# The suppression list is other people's contact details, so it cannot be
# committed to a public repository — which means a scheduled job in CI has no
# way to read it, and a job that cannot check who opted out must not send.
# These point the pipeline at the shared copy so it can.
#
# Note the failure mode: once AUDIT_SUPPRESSION_API is set, drafting REFUSES
# if the store cannot be reached. That is deliberate. "Configured but
# unreachable" is exactly the state where carrying on looks fine and emails
# somebody who asked to be left alone. Unset it to go back to local-only.
AUDIT_SUPPRESSION_API=https://api.bbanetwork.org
AUDIT_SUPPRESSION_TOKEN=

# Turns the opt-out from "reply with stop" into a one-click link. Both are
# required or links stay off. The base must be https — an opt-out that can be
# rewritten in transit is not one.
#
# AUDIT_UNSUBSCRIBE_SECRET must be the same value as the Worker's
# UNSUBSCRIBE_SECRET, or every link produced here will 404 when clicked.
AUDIT_UNSUBSCRIBE_BASE=https://api.bbanetwork.org
AUDIT_UNSUBSCRIBE_SECRET=
