# Copy to .env.local and fill in. Everything here is optional except SITE_URL,
# which must be set before your first real deploy or canonicals and the sitemap
# will point at example.com.

# --- required for production ---
SITE_URL=https://your-domain.com

# Sub-directory the site is served from. GitHub Pages project sites live at
# /<repo>/ and need this or every link and asset 404s; the deploy workflow sets
# it automatically. Leave empty for a root domain.
BASE_PATH=

# --- which vertical to build (see src/lib/sources/) ---
SITE_SOURCE=cheapshark

# --- affiliate programmes ---
# Leave AFFILIATES_ENABLED unset until you have been ACCEPTED into a programme.
# With it off, links are emitted clean and the site still works normally.
AFFILIATES_ENABLED=false
AFF_FANATICAL=
AFF_GMG=
AFF_HUMBLE=

# --- optional editorial enrichment ---
# Free tier is a one-off credit grant, not a monthly refill. The enrichment
# script caches permanently and refuses to exceed --budget.
FIRECRAWL_API_KEY=

# --- search engine ownership verification ---
# From Search Console / Bing "HTML tag" method: the token only, not the whole
# <meta> tag. Public values, not secrets.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
